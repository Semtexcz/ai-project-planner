{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Semtexcz/ai-project-planner/schemas/project.schema.json",
  "title": "Planner project configuration",
  "description": "Project-owned authority map and planning policy. Contains pointers and roles, never copies of requirement text, task state or roadmap outcomes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "name",
    "category",
    "content_root",
    "roles",
    "authorities",
    "verification_profiles",
    "review_policy"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "category": {
      "enum": ["software", "engineering", "methodology"]
    },
    "content_root": {
      "type": "string",
      "minLength": 1,
      "description": "Project-relative root of project-owned planning content."
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "required": ["product_owner"],
      "properties": {
        "product_owner": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/authority" }
    },
    "aliases": {
      "type": "array",
      "items": { "$ref": "#/$defs/alias" },
      "default": []
    },
    "current_milestone": {
      "type": ["string", "null"],
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$",
      "default": null
    },
    "task_order": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" },
      "default": []
    },
    "ordering_policy": {
      "type": "string",
      "minLength": 1,
      "default": "priority,roadmap,id"
    },
    "verification_profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["software", "engineering", "methodology"] }
    },
    "review_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periodic_review"],
      "properties": {
        "periodic_review": { "type": "string", "minLength": 1 },
        "milestone_activation_requires_product_owner": { "type": "boolean", "default": true },
        "notes": { "type": "string" }
      }
    },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "authority": {
      "oneOf": [
        {
          "title": "Native collection",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "owner", "root"],
          "properties": {
            "kind": { "$ref": "#/$defs/authorityKind" },
            "owner": { "type": "string", "minLength": 1 },
            "root": { "type": "string", "minLength": 1 }
          }
        },
        {
          "title": "Explicit adopted record",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "owner", "ref", "format"],
          "properties": {
            "kind": { "$ref": "#/$defs/authorityKind" },
            "id": { "$ref": "#/$defs/recordId" },
            "owner": { "type": "string", "minLength": 1 },
            "ref": { "type": "string", "minLength": 1 },
            "locator": { "type": "string" },
            "format": { "enum": ["native", "markdown", "openspec", "issue"] }
          }
        }
      ]
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target"],
      "properties": {
        "id": { "$ref": "#/$defs/recordId" },
        "target": { "$ref": "#/$defs/recordId" },
        "note": { "type": "string" }
      }
    },
    "authorityKind": {
      "enum": ["strategy", "requirement", "milestone", "task", "decision", "change", "roadmap", "evidence"]
    },
    "recordId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    }
  }
}
